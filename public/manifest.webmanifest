{
  "id": "./",
  "name": "Al-Mustanir",
  "short_name": "Mustanir",
  "description": "Ahmed 2.0 · a calm daily check-in: prayers, reading, routines and what WHOOP and FatSecret measure for you.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0F4A3C",
  "theme_color": "#F6F6F3",
  "categories": ["health", "lifestyle", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Check in", "short_name": "Check in", "description": "Log today's prayers, reading and routines", "url": "./#today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Progress", "short_name": "Progress", "description": "Level, council, medals and trends", "url": "./#progress", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "screenshots/today.png", "sizes": "1170x2532", "type": "image/png", "form_factor": "narrow", "label": "Today: a quick check-in" },
    { "src": "screenshots/progress.png", "sizes": "1170x2532", "type": "image/png", "form_factor": "narrow", "label": "Progress: level, council and medals" }
  ]
